:: This batch file is expected to be run by script nurbs_benchmark_grid.bat
:: generated by CMake in build folder; path to that folder shall be stored
:: in environment variable %BUILD_PATH%.
::
:: Usage:
::
:: - by default (no arguments) runs standard tests using data files in "data" folder;
::   each file is tested with different options, overall 10 iterations for statistics
::   (use the lower CPU and elapsed time values among all runs as a measure)
::
:: - with single argument: run standard tests using the library specified by this argument
::
:: - with two arguments: probe all files in the folder specified by this argument,
::   outputting information on their surfaces and curves
::
:: - with multiple arguments: run benchmark with specified arguments
::
:: One-line digest of each execution of benchmark (arguments and times) is added to
:: file runs.log in the current folder.

set "DATA_DIR=%~dp0data"
set "EXE=%BUILD_PATH%\Release\nurbs_benchmark.exe"

setlocal enabledelayedexpansion

set lib=occt
if "%1" == "" (
  set purpose=test
) else if "%2" == "" (
  set purpose=test
  set "lib=%1"
) else if "%2" == "" (
  set purpose=probe
  set "probedir=%1"
) else (
  set purpose=file
)

if "%purpose%" == "test" (

  echo Running standard tests...
  for /L %%i in (1,1,1) do (
    for %%a in (
      "terrain.step surfaces 1 100000 100"
      "hammer.step surfaces 1-45 10000 100"
      "sphere_nurbs.step surfaces 1 100000 100"
      "sspbs1.step surfaces 1 100000 1000"
      "sspbs2.step surfaces 1 100000 1000"
      "sspbs3.step surfaces 1 100000 1000"
      "sspbs4.step surfaces 1 100000 1000"
      "sspbs5.step surfaces 1 100000 1000"
      "sspbs6.step surfaces 1 100000 1000"
      "sspbs7.step surfaces 1 100000 1000"
      "sspbs8.step surfaces 1 100000 1000"
      "sspbs9.step surfaces 1 100000 1000"
      "sspbs10.step surfaces 1 100000 1000"
      "sspbs11.step surfaces 1 100000 1000"
      "sspbs12.step surfaces 1 100000 1000"
      "sspbs13.step surfaces 1 100000 1000"
      "sspbs14.step surfaces 1 100000 1000"
      "sspbs15.step surfaces 1 100000 1000"
      "ssrbs1.step surfaces 1 100000 1000"
      "ssrbs2.step surfaces 1 100000 1000"
      "ssrbs3.step surfaces 1 100000 1000"
      "ssrbs4.step surfaces 1 100000 1000"
      "ssrbs5.step surfaces 1 100000 1000"
      "ssrbs6.step surfaces 1 100000 1000"
      "ssrbs7.step surfaces 1 100000 1000"
      "ssrbs8.step surfaces 1 100000 1000"
      "ssrbs9.step surfaces 1 100000 1000"
      "ssrbs10.step surfaces 1 100000 1000"
      "ssrbs11.step surfaces 1 100000 1000"
      "ssrbs12.step surfaces 1 100000 1000"
      "ssrbs13.step surfaces 1 100000 1000"
      "ssrbs14.step surfaces 1 100000 1000"
      "ssrbs15.step surfaces 1 100000 1000"
    ) do (
      for %%o in ("sequential" "random") do (
        for /L %%d in (0,1,2) do (
          echo.
          echo =====================================================
          echo Iteration %%~i, case %%~a, %%~o, degree %%~d
          echo =====================================================
          start /AFFINITY 1 /B /HIGH /WAIT %EXE% %DATA_DIR%/%%~a %%~o %%~d perf %lib% 2>>runs.log
        )
      )
    )
  )

) else if "%purpose%" == "probe" (

  echo Probing files in %probedir%...

  echo NOT IMPLEMENTED YET

) else if "%purpose%" == "file" (
  echo Executing nurbs_benchmark %*
  %EXE% %* 2>>runs.log
)

endlocal
